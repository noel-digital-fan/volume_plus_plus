<?xml version="1.0" encoding="utf-8"?>
<!--
    Accessibility service config for VolumeKeyService. We need key-event filtering (to catch the
    volume keys) plus window-state-changed events, which name the foreground app (no window-content
    access) so the panel can prioritise a currently-active app that's playing audio.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeNotificationStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/volume_key_service_description"
    android:notificationTimeout="0" />
